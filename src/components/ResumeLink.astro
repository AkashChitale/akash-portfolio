---
import { site } from "../data/site";
import Icon from "./Icon.astro";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<a
  class:list={["button", compact ? "button-small" : "button-secondary"]}
  href={site.resume.available ? site.resume.path : "/resume/"}
  download={site.resume.available || undefined}
  aria-label={
    site.resume.available ? "Download resume (PDF)" : "Resume information"
  }
>
  Resume
  <Icon name={site.resume.available ? "download" : "arrow"} size={16} />
</a>
