---
import Icon from "./Icon.astro";
import { site } from "../data/site";
interface Props {
  profile: keyof typeof site.profiles;
  iconOnly?: boolean;
}
const { profile, iconOnly = false } = Astro.props;
const labels = {
  github: "GitHub",
  linkedin: "LinkedIn",
  leetcode: "LeetCode",
  email: "Email",
};
const url = site.profiles[profile];
const icon =
  profile === "email" ? "mail" : profile === "leetcode" ? "external" : profile;
---

{url && (
  <a
    class:list={["profile-link", { "icon-button": iconOnly }]}
    href={profile === "email" ? `mailto:${url}` : url}
    aria-label={labels[profile]}
  >
    <Icon name={icon} />
    {!iconOnly && (
      <>
        {labels[profile]}
        {profile !== "email" && profile !== "leetcode" && (
          <span class="profile-out">
            <Icon name="external" size={13} />
          </span>
        )}
      </>
    )}
  </a>
)}
