---
import ProfileLink from "../components/ProfileLink.astro";
---

<section class="problem-solving container" aria-labelledby="problem-title">
  <div>
    <p class="eyebrow mono">ALGORITHMIC FOUNDATION</p>
    <h2 id="problem-title">A habit of solving hard problems.</h2>
    <p>
      1,200+ problems have strengthened my algorithmic thinking, complexity
      analysis, debugging, and reasoning under constraints.
    </p>
    <ProfileLink profile="leetcode" />
  </div>
  <dl class="dsa-metrics">
    <div>
      <dt>Contest rating</dt>
      <dd>
        1,957<span>approx. current</span>
      </dd>
    </div>
    <div>
      <dt>Peak rating</dt>
      <dd>
        2,084<span>LeetCode</span>
      </dd>
    </div>
  </dl>
</section>
