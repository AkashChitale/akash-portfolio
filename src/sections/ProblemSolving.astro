---
import ProfileLink from "../components/ProfileLink.astro";
import { problemSolving } from "../data/site";
---

<section class="problem-solving container" aria-labelledby="problem-title">
  <div>
    <p class="eyebrow mono">ALGORITHMIC FOUNDATION</p>
    <h2 id="problem-title">A habit of solving hard problems.</h2>
    <p>
      {problemSolving.solved} problems have strengthened my algorithmic
      thinking, complexity analysis, debugging, and reasoning under constraints.
    </p>
    <ProfileLink profile="leetcode" />
  </div>
  <dl class="dsa-metrics">
    <div>
      <dt>Contest rating</dt>
      <dd>
        {problemSolving.rating}
        <span>approx. rating</span>
      </dd>
    </div>
    <div>
      <dt>Peak rating</dt>
      <dd>
        {problemSolving.peak}
        <span>LeetCode</span>
      </dd>
    </div>
  </dl>
</section>
