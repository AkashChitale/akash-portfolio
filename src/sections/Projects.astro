---
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import { projects } from "../data/projects";
---

<section id="projects" class="section projects-section">
  <div class="container">
    <div class="section-header-row">
      <SectionHeading
        number="03"
        label="DESIGN DECISIONS, IN CODE"
        title="Selected engineering work."
        description="Secure sessions. Reliable workflows. Less work on the request path."
      />
      <span class="mono section-side-note">
        {String(projects.length).padStart(2, "0")} CASE STUDIES
      </span>
    </div>
    <div class="project-list">
      {projects.map((project, index) => (
        <article
          class:list={["project-row", { "project-featured": index === 0 }]}
          aria-labelledby={`project-${project.slug}`}
        >
          <div class="project-index mono">{project.number}</div>
          <div class="project-main">
            <p class="mono project-kind">
              {index === 0 && <span class="featured-label">FEATURED</span>}
              {project.kind}
            </p>
            <h3 id={`project-${project.slug}`}>{project.name}</h3>
            <p class="project-description">{project.description}</p>
            <div class="project-tech mono">
              {project.technologies.join(" / ")}
            </div>
            <div class="project-links">
              <a
                class="project-case-link"
                href={`/projects/${project.slug}/`}
                aria-label={`Read case study: ${project.name}`}
              >
                Read case study
                <Icon name="arrow" size={18} />
              </a>
              {project.repo && (
                <a
                  class="subtle-link project-repo"
                  href={project.repo}
                  aria-label={`GitHub repository: ${project.name}`}
                >
                  <Icon name="github" size={16} />
                  GitHub
                  <Icon name="external" size={13} />
                </a>
              )}
            </div>
          </div>
          <div class="project-concepts">
            <span class="project-metric">{project.metric}</span>
            <span class="mono">ENGINEERING FOCUS</span>
            <ul>
              {project.concepts.map((concept) => (
                <li>{concept}</li>
              ))}
            </ul>
            {index === 0 && (
              <div
                class="project-flow"
                aria-label="Core path: client, API, database"
              >
                <span>Client</span>
                <Icon name="arrow" size={13} />
                <span>API</span>
                <Icon name="arrow" size={13} />
                <span>Database</span>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
