---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="Résumé — Akash Chitale"
  description="Akash Chitale’s résumé will be available here soon."
  noindex
>
  <section class="notice-page container">
    <p class="eyebrow mono">RÉSUMÉ / COMING SOON</p>
    <h1>
      The work is here.
      <br />
      The PDF is on its way.
    </h1>
    <p>
      My résumé isn’t available to download yet. In the meantime, explore my
      experience and project case studies.
    </p>
    <a href="/#experience" class="button button-primary">
      Explore my experience
      <Icon name="arrow" />
    </a>
  </section>
</BaseLayout>
