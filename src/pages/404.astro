---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="Page not found — Akash Chitale"
  description="This page could not be found. Return to Akash Chitale’s engineering portfolio."
  noindex
>
  <section class="notice-page container">
    <p class="eyebrow mono">404 / ROUTE NOT FOUND</p>
    <h1>
      A missing route.
      <br />A clear way back.
    </h1>
    <p>
      This page may have moved, or the link may be incomplete. The engineering
      work is still here.
    </p>
    <a class="button button-primary" href="/">
      Back to the portfolio
      <Icon name="arrow" />
    </a>
  </section>
</BaseLayout>
